root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
# blank lines inside indented code keep their tabs in this repo, so don't strip trailing whitespace
trim_trailing_whitespace = false

# copied from a tutorial with two-space indents, and kept that way
[service-worker.js]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.toml]
indent_size = 4

[*.md]
indent_style = space
indent_size = 2

[{LICENSE,uv.lock}]
indent_style = unset
